{
    "name": "modufolio/tus-psr7",
    "description": "TUS (Tus Resumable Upload Protocol) server implementation for PHP",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Maarten Thiebou"
        }
    ],
    "require": {
        "php": "^8.2",
        "psr/http-message": "^2.0",
        "modufolio/http": "dev-main",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    },
    "autoload": {
        "psr-4": {
            "Modufolio\\Tus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modufolio\\Tus\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --no-coverage",
        "test:coverage": "php -d xdebug.mode=coverage ./vendor/bin/phpunit --stderr --coverage-html=tests/coverage"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
