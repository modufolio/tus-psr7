{
    "name": "modufolio/tus-psr7",
    "description": "TUS (Tus Resumable Upload Protocol) server implementation for PHP",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Maarten Thiebou"
        }
    ],
    "require": {
        "php": "^8.2",
        "psr/http-message": "^2.0",
        "modufolio/http": "^0.1 || ^0.2",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "mikey179/vfsstream": "^1.6",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Modufolio\\Tus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modufolio\\Tus\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --no-coverage",
        "test:coverage": "php -d xdebug.mode=coverage ./vendor/bin/phpunit --stderr --coverage-html=tests/coverage",
        "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "cs:fix": "vendor/bin/php-cs-fixer fix --allow-risky=yes",
        "stan": "@php -d memory_limit=1G vendor/bin/phpstan analyse --configuration phpstan.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
